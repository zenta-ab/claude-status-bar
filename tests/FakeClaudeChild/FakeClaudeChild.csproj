<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FakeClaudeChild</RootNamespace>
    <AssemblyName>FakeClaudeChild</AssemblyName>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Referenced by ClaudeStatusBar.Tests so its built .exe lands next to the test
         assembly automatically (Codex review testability requirement): a real console
         process that stands in for claude.exe in ClaudeCliChannelSupervisor integration
         tests, driven entirely by ChildProcessSpec (see Data/ChildProcessSpec.cs). -->
  </PropertyGroup>

</Project>
